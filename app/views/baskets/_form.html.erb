<%= form_with(model: basket) do |form| %>
  <% if basket.errors.any? %>
    <div>
      <h2><%= pluralize(basket.errors.count, "error") %> prohibited this basket from being saved:</h2>
      <ul>
        <% basket.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <p>
      <%= form.label :name, "Basket Name (e.g., Bottomless, Doublespout)" %><br>
      <%= form.text_field :name %>
    </p>

    <p>
      <%= form.label :min_dose, "Minimum Dose (g)" %><br>
      <%= form.number_field :min_dose, step: 0.1 %>
    </p>

    <p>
      <%= form.label :max_dose, "Maximum Dose (g)" %><br>
      <%= form.number_field :max_dose, step: 0.1 %>
    </p>

    <br>
    
    <p>
      <%= form.submit "Save Basket" %>
    </p>
  </div>
<% end %>