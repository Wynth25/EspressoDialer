<%= form_with(model: bean) do |form| %>
  <% if bean.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(bean.errors.count, "error") %> prohibited this bean from being saved:</h2>

      <ul>
        <% bean.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :roastery, style: "display: block" %>
    <%= form.text_field :roastery %>
  </div>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :notes, style: "display: block" %>
    <%= form.textarea :notes %>
  </div>

  <div>
    <%= form.label :roast_date, style: "display: block" %>
    <%= form.date_field :roast_date %>
  </div>

  <div>
    <%= form.label :frozen_on, style: "display: block" %>
    <%= form.date_field :frozen_on %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
