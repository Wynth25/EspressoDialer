<%= form_with(model: bean) do |form| %>
  <% if bean.errors.any? %>
    <div>
      <h2><%= pluralize(bean.errors.count, "error") %> prohibited this bean from being saved:</h2>
      <ul>
        <% bean.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <p>
      <%= form.label :roastery, "Roastery" %><br>
      <%= form.text_field :roastery, placeholder: "Onyx Coffee" %>
    </p>

    <p>
      <%= form.label :name, "Bean Name" %><br>
      <%= form.text_field :name, placeholder: "Geometry" %>
    </p>

    <p>
      <%= form.label :description, "Description" %><br>
      <%= form.text_area :description, rows: 8, placeholder: "Geometry has been defined as \"describing spaces that lie beyond the normal range of human experience.\" Soon it will also be defined as \"that coffee from Onyx that I am in love with and completely redefined my relationship with coffee.\" It's our answer for everything and has two of our favorite coffees – a washed processed Ethiopian & Colombian. This blend has become one of our favorite coffees. We love it as a filter coffee, and we love it as espresso. And not only does is it taste great as either but it's easy to dial in as espresso or filter." %>
    </p>

    <p>
      <%= form.label :notes, "Notes" %><br>
      <%= form.text_area :notes, rows: 4, placeholder: "Berries, Stone, Fruit, Earl Grey, Honeysuckle, Round" %>
    </p>

    <p>
      <%= form.label :roast_date, "Roast Date" %><br>
      <%= form.date_field :roast_date %>
    </p>

    <br>

    <p>
      <%= form.submit "Save Bean" %>
    </p>
  </div>
<% end %>