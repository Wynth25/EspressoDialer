<!DOCTYPE html>
<html>
  <head>
    <title>Espresso Dialer</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <!-- PWA Setup for iOS -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Dialer">
    
    <!-- Links to the icon and manifest -->
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest.json">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <% if flash.any? %>
      <div class="flash-overlay">
        <% flash.each do |flash_type, message| %>
          <!-- The data-controller hooks up our JS, and data-action lets you click to dismiss it instantly -->
          <div class="flash-message <%= flash_type %>" 
               data-controller="flash" 
               data-action="click->flash#dismiss">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- This is where your individual pages load -->
    <%= yield %>
  </body>
</html>