<!DOCTYPE html>
<html>
  <head>
    <title>Espresso Dialer</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- PWA Setup for iOS -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Dialer">
    
    <!-- Links to the icon and manifest -->
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest.json">
  </head>

  <body>
    <!-- Standard Rails Flash Messages -->
    <% if notice %>
      <div style="background-color: #d4edda; color: #155724; padding: 10px; text-align: center; margin-bottom: 20px;">
        <%= notice %>
      </div>
    <% end %>
    
    <% if alert %>
      <div style="background-color: #f8d7da; color: #721c24; padding: 10px; text-align: center; margin-bottom: 20px;">
        <%= alert %>
      </div>
    <% end %>

    <!-- This is where your individual pages load -->
    <%= yield %>
  </body>
</html>