<%= turbo_frame_tag "brew_controls_#{recipe.id}" do %>
  <% latest = recipe.latest_brew %>
  
  <div data-controller="brew-adjust" 
       data-brew-adjust-base-dose-value="<%= latest.dose %>" 
       data-brew-adjust-base-grind-value="<%= latest.grind %>"
       align="center">
       
    <%= form_with url: quick_log_recipe_path(recipe), method: :post, data: { turbo_frame: "_top" } do |f| %>




      <div>
        <p style="text-align: center;">
          <%= f.number_field :dose, value: latest.dose, step: 0.1, style: "width: auto; display: inline-block;", 
                data: { brew_adjust_target: "doseInput", action: "input->brew-adjust#manualDose" } %>
        </p>
        <p style="display: flex; justify-content: center; gap: 6px; flex-wrap: nowrap;">
          <button type="button" data-brew-adjust-target="doseBtn" data-action="brew-adjust#selectDose" data-amount="-1.0" style="flex-shrink: 1; padding: 8px 10px; font-size: 0.9rem;">-1.0g</button>
          <button type="button" data-brew-adjust-target="doseBtn" data-action="brew-adjust#selectDose" data-amount="-0.5" style="flex-shrink: 1; padding: 8px 10px; font-size: 0.9rem;">-0.5g</button>
          <button type="button" data-brew-adjust-target="doseBtn" data-action="brew-adjust#selectDose" data-amount="0" style="flex-shrink: 0; padding: 8px 12px; font-size: 0.9rem;">Keep</button>
          <button type="button" data-brew-adjust-target="doseBtn" data-action="brew-adjust#selectDose" data-amount="0.5" style="flex-shrink: 1; padding: 8px 10px; font-size: 0.9rem;">+0.5g</button>
          <button type="button" data-brew-adjust-target="doseBtn" data-action="brew-adjust#selectDose" data-amount="1.0" style="flex-shrink: 1; padding: 8px 10px; font-size: 0.9rem;">+1.0g</button>
        </p>
      </div>




      <br>




      <div>
        <p style="text-align: center;">
          <%= f.number_field :grind, value: latest.grind, step: 0.1, style: "width: auto; display: inline-block;", 
                data: { brew_adjust_target: "grindInput", action: "input->brew-adjust#manualGrind" } %>
        </p>
        <p style="display: flex; justify-content: center; gap: 6px; flex-wrap: nowrap;">
          <button type="button" data-brew-adjust-target="grindBtn" data-action="brew-adjust#selectGrind" data-amount="-0.2" style="flex-shrink: 1; padding: 8px 10px; font-size: 0.9rem;">-0.2</button>
          <button type="button" data-brew-adjust-target="grindBtn" data-action="brew-adjust#selectGrind" data-amount="-0.1" style="flex-shrink: 1; padding: 8px 10px; font-size: 0.9rem;">-0.1</button>
          <button type="button" data-brew-adjust-target="grindBtn" data-action="brew-adjust#selectGrind" data-amount="0" style="flex-shrink: 0; padding: 8px 12px; font-size: 0.9rem;">Keep</button>
          <button type="button" data-brew-adjust-target="grindBtn" data-action="brew-adjust#selectGrind" data-amount="0.1" style="flex-shrink: 1; padding: 8px 10px; font-size: 0.9rem;">+0.1</button>
          <button type="button" data-brew-adjust-target="grindBtn" data-action="brew-adjust#selectGrind" data-amount="0.2" style="flex-shrink: 1; padding: 8px 10px; font-size: 0.9rem;">+0.2</button>
        </p>
      </div>



      <br>



      <p>
        <%= f.submit "SAVE" %>
      </p>

    <% end %>
  </div>
  
<% end %>