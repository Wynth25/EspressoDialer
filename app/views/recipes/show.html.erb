<div>
  <p>
    <%= link_to "← Back to Dashboard", root_path %>
  </p>

  <div>
    <h1><%= @recipe.bean.roastery %> <%= @recipe.bean.name %></h1>
    <p><%= @recipe.bean.description %></p>
    
    <h3><%= @recipe.basket.display_name %></h3>
    <p>
      Dose, Grind (<%= @recipe.latest_brew.dose %>g, <%= @recipe.latest_brew.grind %>)
    </p>
  </div>

  <br>

  <!-- The Magic Interactive Controls -->
  <%= render partial: "recipes/brew_controls", locals: { recipe: @recipe } %>

  <br>
  <hr>

  <div>
    <h3>History coming soon...</h3>
  </div>
</div>