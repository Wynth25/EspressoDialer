<div>
  <%= render "shared/header", title: "Recipe Details" %>

  <div>
    <h1><%= @recipe.bean.roastery %> <%= @recipe.bean.name %></h1>
    <p style="overflow-wrap: anywhere; word-break: break-word;">
      <%= @recipe.bean.description %></p>
    <p style="overflow-wrap: anywhere; word-break: break-word;">
      <%= @recipe.bean.notes %></p>
    
    <h3><%= @recipe.basket.name %> • <%= @recipe.style %></h3>
    
    <h1>
      <%= @recipe.latest_brew.dose %>g, <%= @recipe.latest_brew.grind %>
    </h1>
  </div>

  <br>

  <%= render partial: "recipes/brew_controls", locals: { recipe: @recipe } %>

  <br>
  <hr>

  <div>
    <h3>Brew History</h3>
    <% if @recipe.brews.any? %>
      <ul>
        <% @recipe.brews.order(created_at: :desc).each do |brew| %>
          <li>
            <strong><%= brew.created_at.strftime("%b %d, %Y - %H:%M") %></strong> <br>
            Dose: <%= brew.dose %>g | Grind: <%= brew.grind %>
          </li>
          <br>
        <% end %>
      </ul>
    <% else %>
      <p>No adjustments saved yet.</p>
    <% end %>
  </div>
</div>