<div>
  <p>
    <%= link_to "Back to recipes", recipes_path %>
  </p>

  <div>
    <h1><%= @recipe.bean.roastery %> <%= @recipe.bean.name %></h1>
    <p><%= @recipe.bean.description %></p>
    
    <h3><%= @recipe.basket.display_name %> • <%= @recipe.style %></h3>
    
    <p>
      Dose, Grind (<%= @recipe.latest_brew.dose %>g, <%= @recipe.latest_brew.grind %>)
    </p>
  </div>

  <br>

  <!-- The Magic Interactive Controls -->
  <%= render partial: "recipes/brew_controls", locals: { recipe: @recipe } %>

  <br>
  <hr>

  <div>
    <h3>Brew History</h3>
    <% if @recipe.brews.any? %>
      <ul>
        <% @recipe.brews.order(created_at: :desc).each do |brew| %>
          <li>
            <strong><%= brew.created_at.strftime("%b %d, %Y - %H:%M") %></strong> <br>
            Dose: <%= brew.dose %>g | Grind: <%= brew.grind %>
          </li>
          <br>
        <% end %>
      </ul>
    <% else %>
      <p>No adjustments saved yet.</p>
    <% end %>
  </div>
</div>