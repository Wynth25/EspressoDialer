<div>
  <h1>Espresso recipes</h1>
  
  <div>
    <%= link_to "+ New Bean", new_bean_path %>
    | 
    <%= link_to "+ New Basket", new_basket_path %>
  </div>
  
  <br>

  <% @beans.each do |bean| %>
    <div>
      <h2>
        <%= bean.roastery %> <%= bean.name %> 
        <small>(<%= bean.effective_age_in_days %> days old)</small>
      </h2>

      <% if bean.recipes.any? %>
        <ul>
          <% bean.recipes.each do |recipe| %>
            <li>
              <strong><%= recipe.basket.name %></strong>
              
              <% if recipe.latest_brew %>
                – <%= recipe.latest_brew.dose %>g, Grind: <%= recipe.latest_brew.grind %>
              <% else %>
                – No brews yet
              <% end %>
              
              <%= link_to "[ BREW ]", recipe_path(recipe) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No baskets dialed in yet.</p>
      <% end %>

      <p>
        <%= link_to "+ Dial in a new basket", new_recipe_path %>
      </p>
      
      <hr>
    </div>
  <% end %>
</div>