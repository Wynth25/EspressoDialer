<div data-controller="dashboard">
  
  <!-- Backdrop Overlay (Intercepts taps outside the menu) -->
  <div class="menu-backdrop hidden" data-dashboard-target="backdrop" data-action="click->dashboard#closeDropdown"></div>

  <!-- Capture Header Actions for the Universal Header -->
  <% header_actions = capture do %>
    <div data-dashboard-target="contextActions" class="context-actions hidden">
      <button data-action="dashboard#cancelMode" class="btn-secondary">Cancel</button>
      <button data-action="dashboard#doneMode" class="btn-primary">Done</button>
    </div>

    <div class="dropdown-container">
      <button data-dashboard-target="menuToggle" style="border: none; background: transparent; box-shadow: none; cursor: pointer; font-size: 1.5rem; padding: 0 10px; color: var(--text-brown);" data-action="dashboard#toggleDropdown">
        <i class="fa-solid fa-ellipsis-vertical"></i>
      </button>
      
      <div class="dropdown-menu hidden" data-dashboard-target="dropdownMenu">
        <%= link_to "<i class='bx bxs-coffee-bean'></i> Beans".html_safe, beans_path, class: "dropdown-item" %>
        <%= link_to "<svg xmlns='http://www.w3.org/2000/svg' width='1.15em' height='1.15em' viewBox='0 0 24 24' fill='currentColor' style='display: inline-block; vertical-align: -0.18em;'><path fill-rule='evenodd' d='M1.5 6.5C1.5 5.7 2.2 5 3 5h18c.8 0 1.5.7 1.5 1.5s-.7 1.5-1.5 1.5h-1.2l-1.2 9.5c-.2 1.5-1.5 2.5-3 2.5H8.4c-1.5 0-2.8-1-3-2.5L4.2 8H3c-.8 0-1.5-.7-1.5-1.5zm4.8 4.5h11.4l-.25 2H6.55l-.25-2z' clip-rule='evenodd'/></svg> Baskets".html_safe, baskets_path, class: "dropdown-item" %>
        
        <hr>

        <button type="button" class="dropdown-item" data-action="dashboard#enableSortMode"><i class="fa-solid fa-grip-vertical"></i> Adjust order</button>
        <button type="button" class="dropdown-item" data-action="dashboard#enableDeleteMode"><i class="fa-solid fa-trash-can"></i> Delete recipes</button>
      </div>
    </div>
  <% end %>

  <!-- Universal Header -->
  <%= render "shared/header", 
        title: "Espresso recipes", 
        hide_back: true, 
        action: header_actions %>

  <br>

  <!-- Sortable Bean List -->
  <div data-dashboard-target="beanList">
    <% @beans.each do |bean| %>
      <div data-id="<%= bean.id %>" style="background: transparent;">
        
        <h2 style="display: flex; align-items: center;">
          <span class="drag-handle"><i class="fa-solid fa-grip"></i></span>
          <%= bean.roastery %> <%= bean.name %> 
          <small style="margin-left: 8px; font-weight: normal; font-size: 0.9rem;">
            (<%= bean.effective_age_in_days %> days old)
          </small> 
          <%= link_to "+", new_recipe_path(bean_id: bean.id), class: "add-recipe-link", style: "margin-left: 8px;" %>
        </h2>

        <% if bean.recipes.any? %>
          <div class="recipe-grid" data-dashboard-target="recipeGrid" data-bean-id="<%= bean.id %>">
            <% bean.recipes.each do |recipe| %>
              
              <div class="recipe-card-wrapper" data-id="<%= recipe.id %>">
                
                <%= link_to recipe_path(recipe), class: "recipe-card" do %>
                  <% if recipe.style.to_s.start_with?("Ristretto") %>
                    <div class="recipe-corner-badge">R</div>
                  <% elsif recipe.style.to_s.start_with?("Lungo") %>
                    <div class="recipe-corner-badge">L</div>
                  <% end %>

                  <div class="recipe-card-title">
                    <%= recipe.basket.name %>
                  </div>
                  
                  <div class="recipe-card-stats">
                    <% if recipe.latest_brew %>
                      <div><%= recipe.latest_brew.dose %>g</div>
                      <div class="recipe-card-label"><%= recipe.latest_brew.grind %></div>
                    <% else %>
                      <em style="font-size: 0.85rem; font-weight: 400; color: #888;">No brews</em>
                    <% end %>
                  </div>
                <% end %>

                <!-- Sort Overlay Grip (Sort mode) -->
                <div class="recipe-sort-overlay">
                  <i class="fa-solid fa-grip-vertical"></i>
                </div>

                <!-- Delete Overlay Form (Delete mode) -->
                <%= button_to recipe_path(recipe), method: :delete, form_class: "delete-overlay-form", data: { turbo_confirm: "Delete #{recipe.basket.name} recipe for #{bean.name}?" }, class: "recipe-delete-overlay" do %>
                  <i class="fa-solid fa-trash-can"></i>
                <% end %>
                
              </div>

            <% end %>
          </div>
        <% else %>
          <p>No baskets dialed in yet.</p>
        <% end %>
        
        <hr>
      </div>
    <% end %>
  </div>

</div>






